<!--
  Instalador do DB Connector para Windows (MSI, WiX 5). Instala por usuário, sem pedir administrador, em
  %LOCALAPPDATA%\Programs\DB Connector: o executável e os atalhos "DB Connector" no Menu Iniciar e na Área de
  Trabalho. As conexões não vêm no instalador: são cadastradas (ou importadas) no próprio aplicativo e ficam em
  %APPDATA%\DB Connector\conexoes.json, que a desinstalação mantém. A desinstalação é a do Windows (Configurações →
  Aplicativos), pelo msiexec.

  Montagem: instalador/montar.ps1 (o CI e quem quiser gerar localmente). Variáveis (-d): Versao, Exe, Icone e Licenca.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="DB Connector"
           Manufacturer="FIX-FGA"
           Version="$(Versao)"
           UpgradeCode="6f3b7c1e-2d4a-4b8e-9c55-0a1d7e3f9b21"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="Uma versão mais nova do DB Connector já está instalada." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="icone" SourceFile="$(Icone)" />
    <Property Id="ARPPRODUCTICON" Value="icone" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/FIX-FGA/db-connector-app" />
    <Property Id="ARPCOMMENTS" Value="Acesso aos bancos pelo aplicativo SQL com o login (SSO) no navegador" />

    <!-- Tela simples: boas-vindas com a licença (MIT) e o botão Instalar. -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(Licenca)" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="PastaProgramas" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="DB Connector" />
      </Directory>
    </StandardDirectory>

    <!-- Instalação por usuário: cada componente tem como chave um valor no HKCU (regra do Windows Installer para
         arquivos no perfil do usuário). -->
    <Component Id="Programa" Directory="INSTALLFOLDER" Guid="3c9e8a52-7f1d-4e0b-a6c4-5b2d8e91f037">
      <File Id="Executavel" Source="$(Exe)" Name="db-connector.exe" />
      <RegistryValue Root="HKCU" Key="Software\FIX-FGA\DB Connector" Name="Programa" Type="integer" Value="1" KeyPath="yes" />
      <RemoveFolder Id="RemoverInstalacao" Directory="INSTALLFOLDER" On="uninstall" />
      <RemoveFolder Id="RemoverProgramas" Directory="PastaProgramas" On="uninstall" />
    </Component>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="AtalhoMenuIniciar">
        <Shortcut Id="AtalhoMenu" Name="DB Connector" Description="Acesso aos bancos pelo aplicativo SQL com o login (SSO) no navegador" Target="[INSTALLFOLDER]db-connector.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="icone" />
        <RegistryValue Root="HKCU" Key="Software\FIX-FGA\DB Connector" Name="AtalhoMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="AtalhoAreaDeTrabalho">
        <Shortcut Id="AtalhoDesktop" Name="DB Connector" Description="Acesso aos bancos pelo aplicativo SQL com o login (SSO) no navegador" Target="[INSTALLFOLDER]db-connector.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="icone" />
        <RegistryValue Root="HKCU" Key="Software\FIX-FGA\DB Connector" Name="AtalhoDesktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Package>
</Wix>
