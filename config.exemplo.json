{
  // Nome que aparece na janela (o título do aplicativo para quem usa).
  "nome": "ACME bancos",
  // Texto abaixo do nome (opcional).
  "descricao": "Acesso aos bancos da ACME pelo DBeaver, com o seu login no navegador. Tudo o que você faz fica registrado.",
  // Emissor OIDC (no Keycloak, a URL do realm). O login usa authorization code + PKCE com retorno em
  // http://127.0.0.1:<portaRetorno>/callback: cadastre esse redirect nos clients (públicos) de cada ambiente.
  "emissor": "https://sso.acme.example/realms/interno",
  // Opcional: vai direto a um provedor de identidade do Keycloak (kc_idp_hint), ex.: "microsoft".
  "idpHint": null,
  "portaRetorno": 15431,
  // Database que o aplicativo SQL abre primeiro (cada ambiente pode ter o seu).
  "bancoPadrao": "app",
  "ambientes": [
    // host/porta: o gateway PostgreSQL do ambiente (TLS; recebe o access token como senha). clientId: o client OIDC do
    // ambiente (o token precisa ter a audiência que o gateway confere). portaLocal: onde o aplicativo SQL conecta.
    { "nome": "dev", "host": "dev.db.acme.example", "porta": 5432, "clientId": "db-dev", "portaLocal": 15432 },
    { "nome": "prod", "host": "db.acme.example", "porta": 5432, "clientId": "db-prod", "portaLocal": 15434, "somenteLeitura": true }
  ]
}
