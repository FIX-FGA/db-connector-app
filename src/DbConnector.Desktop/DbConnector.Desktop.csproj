<Project Sdk="Microsoft.NET.Sdk">

  <!-- DB Connector: o aplicativo (janela) de quem acessa bancos PostgreSQL atrás de um gateway com login OIDC (SSO),
       pelo DBeaver ou outro aplicativo SQL. Avalonia: Windows, Linux e macOS. Nome, ambientes e emissor vêm da
       configuração (config.json que o instalador grava ao lado do executável, ou na opção config).
       Publicação (CI): um executável só, com o runtime dentro:
       dotnet publish -r win-x64 -p:PublishSingleFile=true -p:SelfContained=true -p:EnableCompressionInSingleFile=true -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DbConnector.Desktop</RootNamespace>
    <AssemblyName>db-connector</AssemblyName>
    <Product>DB Connector</Product>
    <Company>FIX-FGA</Company>
    <Description>Proxy local de SSO (OIDC) para bancos PostgreSQL: o aplicativo SQL conecta em localhost e o login é no navegador</Description>
    <ApplicationIcon>Assets\db-connector.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- No executável único, as bibliotecas nativas (Skia, HarfBuzz) vão dentro e são extraídas na primeira execução. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbConnector.Core\DbConnector.Core.csproj" />
  </ItemGroup>

</Project>
