<Project Sdk="Microsoft.NET.Sdk">

  <!-- fix-bancos-cli: o FIX bancos sem janela (Linux sem desktop, scripts). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Fix.Bancos.Cli</RootNamespace>
    <AssemblyName>fix-bancos-cli</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Product>FIX bancos</Product>
    <Description>FIX bancos (linha de comando): acesso aos bancos do FIX pelo DBeaver com o login no navegador</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fix.Bancos\Fix.Bancos.csproj" />
  </ItemGroup>

</Project>
