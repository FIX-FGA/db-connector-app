<Project Sdk="Microsoft.NET.Sdk">

  <!-- Núcleo do DB Connector (login OIDC no navegador, senha local, porta local para o aplicativo SQL, protocolo do
       PostgreSQL), usado pelo aplicativo (DbConnector.Desktop) e pela linha de comando (DbConnector.Cli). -->
  <PropertyGroup>
    <RootNamespace>DbConnector</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Configuração de quem distribui (nome, emissor, ambientes): o CI gera este arquivo a partir da variável
         DB_CONNECTOR_CONFIG e ele vai embutido no executável. Fora do git; sem ele, o aplicativo abre sem ambientes. -->
    <EmbeddedResource Include="config.json" LogicalName="config.json" Condition="Exists('config.json')" />
  </ItemGroup>

</Project>
