<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fix.Bancos.Desktop"
        xmlns:sys="using:System"
        x:Class="Fix.Bancos.Desktop.JanelaPrincipal"
        x:DataType="local:JanelaVm"
        Title="FIX bancos"
        Icon="/Assets/fix-bancos.ico"
        Width="760" Height="820" MinWidth="420" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Fundo}">

  <!-- A janela toda rola: com ela pequena, nada fica cortado. O conteúdo tem largura máxima e fica centralizado. -->
  <DockPanel>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource CartaoBorda}" BorderThickness="0,1,0,0" Padding="20,8">
      <TextBlock Classes="secundario" FontSize="12" TextTrimming="CharacterEllipsis"
                 Text="{Binding Aviso, FallbackValue='', TargetNullValue='Fechar a janela encerra as conexões abertas.'}" />
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="860" Margin="20,18,20,20">

        <!-- Cabeçalho -->
        <Grid ColumnDefinitions="Auto,*">
          <Image Source="/Assets/fix-bancos.png" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="FIX bancos" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Classes="secundario" TextWrapping="Wrap"
                       Text="Acesso aos bancos dos ambientes pelo DBeaver, com o seu login da FIX no navegador. Tudo o que você faz fica registrado com o seu e-mail." />
          </StackPanel>
        </Grid>

        <!-- Senha local -->
        <Border Classes="cartao" Margin="0,18,0,0" Background="{DynamicResource SenhaFundo}">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2" Margin="0,0,12,0">
              <TextBlock Classes="secundario" FontSize="12" Text="SENHA LOCAL DESTA SESSÃO" />
              <SelectableTextBlock Text="{Binding SenhaLocal}" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"
                                   FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Destaque}" />
              <TextBlock Classes="secundario" FontSize="12" TextWrapping="Wrap"
                         Text="Vai no campo senha do DBeaver. Muda a cada vez que o FIX bancos abre; não compartilhe." />
            </StackPanel>
            <Button Grid.Column="1" Content="Copiar" Command="{Binding CopiarSenha}" VerticalAlignment="Center" Padding="16,8" />
          </Grid>
        </Border>

        <!-- Ambientes -->
        <TextBlock Classes="secao" Text="AMBIENTES" />
        <ItemsControl ItemsSource="{Binding Ambientes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:AmbienteVm">
              <Border Classes="cartao" Margin="0,0,0,10">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <!-- Título: quebra de linha se faltar espaço, em vez de empurrar os botões. -->
                  <WrapPanel VerticalAlignment="Center" Margin="0,0,10,0">
                    <Ellipse Width="11" Height="11" Fill="{Binding Cor}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Nome}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Classes="secundario" Text="{Binding Permissao}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Rotulo}" Foreground="{Binding Cor}" VerticalAlignment="Center" />
                  </WrapPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Copiar URL" Command="{Binding CopiarUrl}" IsVisible="{Binding Ligado}"
                            ToolTip.Tip="URL JDBC para colar no DBeaver (Nova conexão → PostgreSQL → URL)" />
                    <Button Content="Entrar" Command="{Binding EntrarDeNovo}" IsVisible="{Binding PodeEntrarDeNovo}"
                            ToolTip.Tip="Abre o navegador para o login de novo" />
                    <Button Content="{Binding Acao}" Command="{Binding Alternar}" MinWidth="96"
                            HorizontalContentAlignment="Center" Classes.principal="{Binding !Ligado}" />
                  </StackPanel>
                  <!-- Detalhe na largura toda do cartão. -->
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="secundario" Text="{Binding Detalhe}"
                             TextWrapping="Wrap" Margin="21,8,0,0" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Como conectar -->
        <Expander Header="Como configurar no DBeaver" HorizontalAlignment="Stretch" Margin="0,4,0,0">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
            <Grid.Styles>
              <Style Selector="TextBlock">
                <Setter Property="Margin" Value="0,3" />
                <Setter Property="TextWrapping" Value="Wrap" />
              </Style>
              <Style Selector="TextBlock.secundario">
                <Setter Property="Margin" Value="0,3,20,3" />
              </Style>
            </Grid.Styles>
            <TextBlock Grid.Row="0" Classes="secundario" Text="Conexão" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Nova conexão → PostgreSQL (ou cole a URL do botão Copiar URL)" />
            <TextBlock Grid.Row="1" Classes="secundario" Text="Host e porta" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="localhost · dev 15432, qa 15433, prod 15434" />
            <TextBlock Grid.Row="2" Classes="secundario" Text="Database" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="fix_core, com “Show all databases” marcado para ver os outros" />
            <TextBlock Grid.Row="3" Classes="secundario" Text="Usuário" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="qualquer um (quem vale é o seu login no navegador)" />
            <TextBlock Grid.Row="4" Classes="secundario" Text="Senha" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="a senha local acima (atualize no DBeaver sempre que o FIX bancos abrir)" />
            <TextBlock Grid.Row="5" Classes="secundario" Text="SSL" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="desligado: o trecho local não sai da máquina e o FIX bancos cifra até o servidor" />
          </Grid>
        </Expander>

        <!-- Atividade: altura própria, com rolagem dentro. -->
        <TextBlock Classes="secao" Text="ATIVIDADE" />
        <Border Classes="cartao" Padding="12,8" Height="200">
          <Panel>
            <TextBlock Classes="secundario" FontSize="12" Text="Nada ainda: as conexões e os logins aparecem aqui."
                       IsVisible="{Binding !Atividade.Count}" />
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Atividade}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="sys:String">
                    <SelectableTextBlock Text="{Binding}" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"
                                         FontSize="12" TextWrapping="Wrap" Margin="0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Panel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
